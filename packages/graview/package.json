{
  "name": "graview",
  "version": "0.1.18",
  "type": "module",
  "description": "The Graview command line: start a product, check its declaration, write its agent docs, serve its store, host it for an agent over MCP, apply an act to it, sync its seed, install the authoring skills. The tool; @graview/* is the framework.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "declarative",
    "cli",
    "scaffolder"
  ],
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/graview.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "graview": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/guest": "workspace:*",
    "@graview/ship": "workspace:*",
    "@graview/skills": "workspace:*",
    "@graview/tools": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/graview"
  },
  "publishConfig": {
    "access": "public"
  }
}
