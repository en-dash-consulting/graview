{
  "name": "@graview/studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The declaration itself as a graph: kinds, fields, edges, acts, rules, roles and grants as nodes, edited with ordinary mutations in Graview's own interface, checked before they are applied, migrated, and written back as the files graview create writes.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/layout": "workspace:*",
    "@graview/pages": "workspace:*",
    "@graview/primitives": "workspace:*",
    "@graview/react": "workspace:*",
    "@graview/ship": "workspace:*",
    "@graview/tools": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endash/graview.git",
    "directory": "packages/studio"
  },
  "publishConfig": {
    "access": "public"
  }
}
