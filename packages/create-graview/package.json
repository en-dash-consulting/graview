{
  "name": "create-graview",
  "version": "0.1.14",
  "type": "module",
  "description": "Start a product on Graview: `npm create graview my-app`. The conventional door to `graview create`.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "declarative",
    "create",
    "scaffold",
    "starter",
    "cli"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-graview": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "graview": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/create-graview"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/create-graview.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
