{
  "name": "@graview/render",
  "version": "0.1.12",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "default": "./dist/gpu.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/layout": "workspace:*"
  },
  "peerDependencies": {
    "@webgpu/types": "^0.1.60"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.6.5"
  },
  "description": "The spatial renderer. The DOM path is what ships; the GPU capture path is EXPERIMENTAL — see README.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "declarative",
    "renderer",
    "canvas",
    "webgpu"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/render"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/render.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
