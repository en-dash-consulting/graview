{"format":"graview-document","formatVersion":1,"name":"Book Manuscript",
"acts":{"add-audience":{"creates":"audience","description":"Add a new audience.","title":"Add an audience"},"add-chapter":{"creates":"chapter","description":"Add a new chapter to the manuscript.","title":"Add chapter","writes":["title"]},"add-goal":{"creates":"goal","description":"Add a new goal.","title":"Add a goal"},"add-idea":{"creates":"idea","description":"Add a new idea.","title":"Add an idea"},"add-purpose":{"creates":"purpose","description":"Add a new purpose.","title":"Add a purpose"},"add-story":{"creates":"story","description":"Add a new story.","title":"Add a story"},"cut-story":{"description":"Mark a story as cut from the book.","on":"story","sets":{"status":"cut"},"title":"Cut"},"deliver-goal":{"connects":"delivers","description":"Say which goal a chapter delivers on.","on":"chapter","title":"Delivers goal"},"keep-story":{"description":"Mark a candidate story as a keeper.","on":"story","sets":{"status":"keeper"},"title":"Keep"},"mark-keeper":{"allowedWhen":"status == 'raw'","description":"Promote an idea from raw to a keeper.","on":"idea","refusal":"{title} is not raw","sets":{"status":"keeper"},"title":"Mark keeper"},"place-in-chapter":{"connects":"inChapter","description":"Say which chapter an idea belongs to.","on":"idea","replaces":true,"title":"Place in chapter"},"save-draft":{"description":"Save the chapter's working draft content.","on":"chapter","title":"Save draft","writes":["draft"]},"serve-audience":{"connects":"serves","description":"Say which audience a goal serves.","on":"goal","title":"Serve audience"},"set-word-count":{"description":"Record how many words this chapter has.","on":"chapter","title":"Set word count","writes":["wordCount"]},"use-in-chapter":{"connects":"usedIn","description":"Say which chapter a story could appear in.","on":"story","title":"Use in chapter"}},
"brand":{"accent":"#1f4e8c","typography":{"display":"system-serif"}},
"kinds":{"audience":{"describe":"{priority}","fields":{"name":{"required":true,"type":"string"},"priority":{"default":"primary","options":["primary","secondary","tertiary"],"required":true,"type":"enum"}},"noun":"audience","plural":"audiences"},
"chapter":{"computed":{"ideaCount":{"expr":"count(in('inChapter'))","label":"Ideas"},"storyCount":{"expr":"count(in('usedIn') where status != 'cut')","label":"Stories"}},"describe":"{status} · {wordCount} words","edges":{"delivers":{"cardinality":"many","to":["goal"]}},"fields":{"draft":{"format":"markdown","type":"text"},"status":{"default":"draft","options":["draft","revising","done"],"required":true,"type":"enum"},"summary":{"format":"markdown","type":"text"},"title":{"required":true,"type":"string"},"wordCount":{"min":0,"type":"integer"}},"glance":["title","status","wordCount"],"noun":"chapter","plural":"chapters"},
"goal":{"computed":{"chapterCount":{"expr":"count(in('delivers'))","label":"Chapters"},"ideaCount":{"expr":"count(in('supports'))","label":"Ideas"},"storyCount":{"expr":"count(in('backs') where status != 'cut')","label":"Stories"}},"describe":"{priority}","edges":{"serves":{"cardinality":"many","to":["audience"]}},"fields":{"priority":{"default":"must-have","options":["must-have","should-have","nice-to-have"],"required":true,"type":"enum"},"statement":{"label":"Takeaway","required":true,"type":"string"}},"label":"{statement}","noun":"goal","plural":"goals"},
"idea":{"describe":"{status} · {point|words}","edges":{"inChapter":{"cardinality":"one","to":["chapter"]},"supports":{"cardinality":"many","to":["goal"]}},"fields":{"point":{"format":"markdown","required":true,"type":"text"},"status":{"default":"raw","options":["raw","keeper","drafted"],"required":true,"type":"enum"},"title":{"label":"Working title","required":true,"type":"string"}},"label":"{title}","noun":"idea","plural":"ideas"},
"purpose":{"describe":"{thesis|words}","fields":{"coverLine":{"label":"Cover line","type":"string"},"thesis":{"required":true,"type":"text"},"title":{"label":"Working title","required":true,"type":"string"}},"label":"{title}","noun":"purpose","plural":"purpose"},
"story":{"describe":"{type} · {status}","edges":{"backs":{"cardinality":"many","to":["goal"]},"usedIn":{"cardinality":"many","to":["chapter"]}},"fields":{"factCheck":{"default":"unchecked","label":"Fact check","options":["unchecked","partly verified","verified","watch-out"],"required":true,"type":"enum"},"status":{"default":"candidate","options":["candidate","keeper","cut"],"required":true,"type":"enum"},"story":{"format":"markdown","type":"text"},"title":{"required":true,"type":"string"},"type":{"default":"person","options":["person","study","history","concept"],"required":true,"type":"enum"},"whyItFits":{"format":"markdown","label":"Why it fits","type":"text"}},"glance":["title","type","status"],"label":"{title}","noun":"story","plural":"stories"}},
"pages":{"first":"home","hide":["story","idea","goal","chapter","audience"],"order":["purpose","audience","goal","chapter","idea"]},
"policy":{"grants":[{"describe":"Owners and editors may do anything the app offers.","mutations":"*","roles":["owner","editor"]}]},
"roles":["owner","editor","viewer"],
"rules":{"chapter-has-goal":{"over":"chapter","repairs":[{"act":"deliver-goal"}],"require":"count(out('delivers')) > 0","says":"{title} delivers on no goal yet","title":"A chapter delivers something"},"goal-has-audience":{"over":"goal","repairs":[{"act":"serve-audience"}],"require":"count(out('serves')) > 0","says":"{statement} serves no audience yet","title":"A goal serves someone"}},
"views":{"chapter":{"row":[{"title":"{title}"},{"badge":"{status}"},{"text":"{ideaCount} ideas · {storyCount} stories"}],"card":[{"title":"{title}"},{"badge":"{status}"},{"text":"{summary}"}]},
"goal":{"card":[{"title":"{statement}"},{"badge":"{priority}"},{"text":"{chapterCount} chapters · {storyCount} stories · {ideaCount} ideas"},{"as":"row","empty":"No chapter delivers this yet","list":"in('delivers')","sort":"title"}],"row":[{"title":"{statement}"},{"badge":"{priority}"}]},
"home":[{"direction":"column","group":[{"show":[{"badge":"{first(all('purpose')).coverLine}","tone":"accent"}],"when":"first(all('purpose')).coverLine != null"},{"badge":"Your book","tone":"accent"},{"headline":"{first(all('purpose')).title}"},{"text":"{first(all('purpose')).thesis}"}]},{"divider":true},{"title":"Where the book stands"},{"direction":"row","group":[{"as":"number","figure":"sum(all('chapter'), wordCount)","label":"Words written"},{"as":"number","figure":"count(all('chapter') where draft != null)","label":"Chapters drafted, of {count(all('chapter'))}"},{"as":"number","figure":"count(all('idea') where status == 'keeper')","label":"Keeper ideas"},{"as":"number","figure":"count(all('story') where status == 'keeper')","label":"Keeper stories"}]},{"progress":{"max":"count(all('chapter'))","value":"count(all('chapter') where status == 'done')"}},{"text":"Chapters: {count(all('chapter') where status == 'draft')} in draft · {count(all('chapter') where status == 'revising')} revising · {count(all('chapter') where status == 'done')} done","tone":"neutral"},{"divider":true},{"title":"What to work on next"},{"show":[{"text":"✍️ Start writing: the next chapter with no words yet. Open it and draft a first page — rough is fine.","tone":"accent"},{"as":"card","limit":1,"list":"all('chapter') where draft == null","sort":"title"}],"when":"count(all('chapter') where draft == null) > 0"},{"show":[{"text":"💡 {count(all('idea') where status == 'raw')} raw ideas to triage — keep the ones that land.","tone":"warn"},{"as":"row","limit":3,"list":"all('idea') where status == 'raw'"}],"when":"count(all('idea') where status == 'raw') > 0"},{"show":[{"text":"📚 {count(all('story') where status == 'candidate')} candidate stories waiting for Keep or Cut — open the Review queue.","tone":"warn"},{"as":"row","limit":3,"list":"all('story') where status == 'candidate'"}],"when":"count(all('story') where status == 'candidate') > 0"},{"show":[{"text":"🔎 {count(all('story') where status == 'keeper' and factCheck == 'unchecked')} keeper stories still unchecked — see Fact check.","tone":"bad"}],"when":"count(all('story') where status == 'keeper' and factCheck == 'unchecked') > 0"},{"divider":true},{"title":"The spine: what readers walk away with"},{"as":"card","list":"all('goal')"},{"title":"The outline"},{"as":"row","list":"all('chapter')","sort":"title"}],
"idea":{"card":[{"title":"{title}"},{"badge":"{status}"},{"text":"{point}"}],"row":[{"title":"{title}"},{"badge":"{status}"}]},
"story":{"card":[{"title":"{title}"},{"badge":"{type}"},{"badge":"{status}"},{"badge":"{factCheck}"},{"text":"{whyItFits}"}],"row":[{"title":"{title}"},{"badge":"{type}"},{"badge":"{status}"},{"badge":"{factCheck}"}]}}}
