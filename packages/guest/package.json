{
  "name": "@graview/guest",
  "version": "0.1.7",
  "type": "module",
  "description": "Guest views: somebody else's React or plain script in a sandboxed frame, or a hardened classic worker drawing a component kit, shown only what the viewer may see, able only to ask for acts the viewer's seat then applies.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "iframe",
    "sandbox",
    "guest-view",
    "web-worker",
    "remote-dom"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./host/worker": {
      "types": "./dist/host/worker.d.ts",
      "default": "./dist/host/worker.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/react": "workspace:*",
    "@remote-dom/core": "1.12.0",
    "@remote-dom/polyfill": "1.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "esbuild": ">=0.20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/worker/*.js",
    "./src/worker/*.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/guest"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/guest.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
