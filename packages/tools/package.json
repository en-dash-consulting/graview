{
  "name": "@graview/tools",
  "version": "0.1.12",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/ship": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "description": "Derived affordances and the agent tool surface, generated from the same declarations; graview mcp and graview apply host it against a real store.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "declarative",
    "agents",
    "llm",
    "tool-calling",
    "mcp",
    "affordances"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/tools.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
