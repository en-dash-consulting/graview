{
  "name": "@graview/ship",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@graview/core": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  },
  "description": "What every deployment needs, hosted or self-hosted: persistence wiring, op-log-native migrations, export, health.",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endash/graview.git",
    "directory": "packages/ship"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "graview-serve": "./dist/cli.js"
  }
}
