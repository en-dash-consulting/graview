{
  "format": "graview-document",
  "formatVersion": 1,
  "name": "Secret Santa",
  "description": "Who gives to whom, kept from everybody but the giver.",
  "kinds": {
    "participant": {
      "noun": "participant",
      "plural": "participants",
      "description": "Somebody in the draw: their record's id is their principal's.",
      "people": true,
      "fields": {
        "name": { "type": "string", "required": true },
        "wish": { "type": "text", "description": "what they would like" }
      }
    },
    "match": {
      "noun": "match",
      "plural": "matches",
      "description": "One giver and the person they give to.",
      "label": "{note}",
      "fields": {
        "note": { "type": "string", "required": true }
      },
      "edges": {
        "givenBy": { "to": ["participant"], "cardinality": "one", "description": "who gives", "inverse": "the match they give in" },
        "givesTo": { "to": ["participant"], "cardinality": "one", "description": "who receives", "inverse": "the match they receive in" }
      }
    }
  },
  "acts": {
    "add-participant": { "title": "Add a participant", "creates": "participant" },
    "draw": {
      "title": "Draw a match",
      "creates": "match",
      "effects": [
        { "connect": "givenBy", "from": "$new", "to": "$giver" },
        { "connect": "givesTo", "from": "$new", "to": "$receiver" }
      ]
    }
  },
  "roles": ["organizer", "participant"],
  "policy": {
    "grants": [
      { "roles": ["organizer"], "mutations": "*" },
      { "roles": ["participant"], "mutations": ["edit-participant"], "kinds": ["participant"], "self": true, "describe": "Anyone may change their own wish." }
    ],
    "sees": [
      { "roles": "*", "kinds": ["participant"] },
      { "roles": ["organizer"], "kinds": ["match"] },
      { "roles": ["participant"], "kinds": ["match"], "via": "givenBy" }
    ]
  }
}
