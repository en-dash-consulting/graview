    {"id": "person-john", "kind": "person", "name": "John Halberstadt", "role": "Head of Consulting Operations", "notes": "About a year in; hired to shore up business and land sales. Hoped to co-design a high-autonomy / low-overhead OS. Informal pull across pipeline, pricing, staffing, delivery — without feeling he owns anything. Seat should be outcomes + decision rights on components, not people-management."},
    {"id": "comp-fit-calls", "kind": "component", "name": "Fit calls", "summary": "Judging whether En Dash is the right fit. Nick is currently best at this; keep careful.", "ownership": "nick_owns", "area": "pipeline", "x": 0.5, "y": 0.27, "code": "Fit"},
    {"id": "comp-capacity-picture", "kind": "component", "name": "Capacity picture", "summary": "Who is free, how capacity is read across the roster. Nick is wary of early handoff here.", "ownership": "nick_owns", "area": "delivery", "x": 0.22, "y": 0.12, "code": "Cap"},
    {"id": "comp-assignment", "kind": "component", "name": "Assignment (who gets what)", "summary": "Who pairs onto which work. Decision rights stay with Nick for now.", "ownership": "nick_owns", "area": "delivery", "x": 0.08, "y": 0.12, "code": "Assign"},
    {"id": "comp-hiring", "kind": "component", "name": "Hiring when needed", "summary": "When and how to hire. Not a people-management seat for John.", "ownership": "nick_owns", "area": "people", "x": 0.22, "y": 0.27, "code": "Hire"},
    {"id": "comp-people-growth", "kind": "component", "name": "People growth", "summary": "Growth conversations and development paths. Not a handoff to John; stays with Nick for now.", "ownership": "nick_owns", "area": "people", "x": 0.36, "y": 0.27, "code": "Growth"},
    {"id": "comp-early-risk", "kind": "component", "name": "Early risk signals", "summary": "Reading early signals that delivery is drifting before it needs rescue.", "ownership": "nick_owns", "area": "delivery", "x": 0.5, "y": 0.12, "code": "Risk"},
    {"id": "comp-delivery-rescue", "kind": "component", "name": "Delivery rescue", "summary": "Gray area — when a delivery needs rescue. Ownership still fuzzy.", "ownership": "nick_owns", "area": "delivery", "x": 0.36, "y": 0.12, "code": "Rescue"},
    {"id": "comp-cash-runway", "kind": "component", "name": "Near-term cash / runway", "summary": "Near-term cash and runway picture. Timing of any handoff depends on trust elsewhere first.", "ownership": "nick_owns", "area": "finance", "x": 0.78, "y": 0.12, "code": "Cash"},
    {"id": "comp-company-health", "kind": "component", "name": "Company-health read", "summary": "Overall company-health read from the numbers. Stays with Nick for now.", "ownership": "nick_owns", "area": "finance", "x": 0.64, "y": 0.12, "code": "Health"},
    {"id": "comp-toolkit-content", "kind": "component", "name": "Toolkit content", "summary": "Content and substance of the Toolkit product. Hard and multi-faceted.", "ownership": "nick_owns", "area": "product", "x": 0.92, "y": 0.27, "code": "Toolkit"},
    {"id": "comp-graview-bets", "kind": "component", "name": "Graview / product bets", "summary": "Product bets including Graview — where to invest product energy.", "ownership": "nick_owns", "area": "product", "x": 0.64, "y": 0.27, "code": "Graview"},
    {"id": "comp-sites-microapps", "kind": "component", "name": "Sites / micro-apps", "summary": "Sites and micro-apps as product surfaces.", "ownership": "nick_owns", "area": "product", "x": 0.78, "y": 0.27, "code": "Sites"},
    {"id": "comp-saas-admin", "kind": "component", "name": "SaaS admin", "summary": "SaaS admin for sites and micro-apps. Currently on Nick; candidate to slice later.", "ownership": "nick_owns", "area": "infra", "x": 0.08, "y": 0.27, "code": "SaaS"},
    {"id": "comp-cloud-infra", "kind": "component", "name": "Cloud infra", "summary": "Cloud infrastructure for sites and micro-apps. Currently on Nick.", "ownership": "nick_owns", "area": "infra", "x": 0.92, "y": 0.12, "code": "Cloud"},
    {"id": "comp-proposal-write", "kind": "component", "name": "Proposal write", "summary": "Drafting proposals. Shared between Nick and John.", "ownership": "shared", "area": "pipeline", "x": 0.86, "y": 0.42, "code": "Prop-write"},
    {"id": "comp-proposal-finalization", "kind": "component", "name": "Proposal finalization", "summary": "Closing and shaping proposals. Nick still strong on proposals and fit; handoff is help, not wholesale.", "ownership": "shared", "area": "pipeline", "x": 0.62, "y": 0.42, "code": "Prop-fin"},
    {"id": "comp-offer-shape", "kind": "component", "name": "Offer shape", "summary": "How offers are shaped. Flexible: system design plus Nick autonomy on exceptions.", "ownership": "shared", "area": "pipeline", "x": 0.14, "y": 0.42, "code": "Offer"},
    {"id": "comp-pricing", "kind": "component", "name": "Pricing", "summary": "Pricing posture. Co-owned; Nick keeps exception autonomy.", "ownership": "shared", "area": "pipeline", "x": 0.38, "y": 0.42, "code": "Price"},
    {"id": "comp-weekly-sync", "kind": "component", "name": "Weekly sync pattern", "summary": "How the weekly sync pattern works — an OS piece, co-owned Nick + John.", "ownership": "shared", "area": "os", "x": 0.8, "y": 0.56, "code": "Sync"},
    {"id": "comp-endash-time", "kind": "component", "name": "En Dash time selection", "summary": "How En Dash-billed time gets chosen. Pull, not push.", "ownership": "shared", "area": "os", "x": 0.2, "y": 0.56, "code": "ED-time"},
    {"id": "comp-naming-ownership", "kind": "component", "name": "Naming ownership", "summary": "How ownership gets named. Small OS partnership piece.", "ownership": "shared", "area": "os", "x": 0.5, "y": 0.56, "code": "Name"},
    {"id": "comp-outbound-hunt", "kind": "component", "name": "Outbound hunt", "summary": "Outbound and proactive pipeline hunt — historically reactive, now shifting. Plausible early handoff.", "ownership": "proposed_handoff", "area": "pipeline", "x": 0.36, "y": 0.75, "code": "Outbound"},
    {"id": "comp-pipeline-hygiene", "kind": "component", "name": "Inbound / pipeline hygiene", "summary": "Inbound pipeline hygiene and follow-through. Plausible early handoff.", "ownership": "proposed_handoff", "area": "pipeline", "x": 0.08, "y": 0.75, "code": "Inbound"},
    {"id": "comp-relationship-marketing", "kind": "component", "name": "Relationship marketing", "summary": "Helping others with relationship marketing. Plausible early handoff / co-own.", "ownership": "proposed_handoff", "area": "pipeline", "x": 0.5, "y": 0.75, "code": "Rel"},
    {"id": "comp-line-health", "kind": "component", "name": "Line project health oversight", "summary": "Watching health of line/client projects — BD-adjacent oversight seat. Proposed for John.", "ownership": "proposed_handoff", "area": "pipeline", "x": 0.22, "y": 0.75, "code": "Line"},
    {"id": "comp-public-writing", "kind": "component", "name": "Public writing / site voice", "summary": "Public writing and site voice. Plausible early handoff.", "ownership": "proposed_handoff", "area": "voice", "x": 0.64, "y": 0.75, "code": "Writing"},
    {"id": "comp-speaking-linkedin", "kind": "component", "name": "Speaking / LinkedIn", "summary": "Speaking and LinkedIn presence. Plausible early handoff.", "ownership": "proposed_handoff", "area": "voice", "x": 0.78, "y": 0.75, "code": "Speak"},
    {"id": "con-no-default-hierarchy", "kind": "constraint", "name": "No default hierarchy", "text": "Do not default to hierarchy except where it is genuinely needed.", "strength": "hard"},
    {"id": "con-no-report-to", "kind": "constraint", "name": "No invented report-to", "text": "Do not invent reporting lines unless necessary. John's seat is not people reporting to him.", "strength": "hard"},
    {"id": "con-pull-not-push", "kind": "constraint", "name": "Pull, not push", "text": "Prefer pull and intrinsic motivation over push utilization theater. Idle is bill En Dash time, not bench.", "strength": "hard"},
    {"id": "con-everyone-partners-os", "kind": "constraint", "name": "Everyone partners on the OS", "text": "Everyone should grow into partnering on the evolving system. The OS evolves from what people say and feel.", "strength": "preference"},
    {"id": "con-john-outcomes-not-people", "kind": "constraint", "name": "John: outcomes and decision rights", "text": "John's distinctiveness is accountability for outcomes and decision rights on components — not managing people.", "strength": "hard"},
    {"id": "con-ownership-before-feedback", "kind": "constraint", "name": "Clear ownership before feedback authority", "text": "Feedback lands poorly without a named domain. Clear ownership domains first; feedback authority follows the domain, not the other way around.", "strength": "hard"},
    {"id": "rev-long-contracts", "kind": "revenue-stream", "name": "Long-term contracts", "summary": "Core today; diversifying so the firm is less dependent on them.", "maturity": "core"},
    {"id": "rev-discoveries", "kind": "revenue-stream", "name": "Discoveries", "summary": "Shorter discovery engagements — growing bet.", "maturity": "growing"},
    {"id": "rev-trainings", "kind": "revenue-stream", "name": "Trainings", "summary": "Training offerings as a diversifying line.", "maturity": "growing"},
    {"id": "rev-toolkit", "kind": "revenue-stream", "name": "Product / Toolkit", "summary": "Productized Toolkit revenue.", "maturity": "nascent"},
    {"id": "rev-ndx", "kind": "revenue-stream", "name": "n-dx OSS", "summary": "Open-source n-dx ecosystem — leverage and optionality more than direct revenue today.", "maturity": "nascent"},
    {"id": "q-john-first-handoffs", "kind": "open-question", "name": "Which components hand off to John first?", "detail": "Outbound hunt, inbound/pipeline hygiene, relationship marketing, line project health oversight, public writing, and speaking/LinkedIn look plausible — confirm sequence and decision rights.", "status": "open"},
    {"id": "q-finance-timing", "kind": "open-question", "name": "When is finance ready to hand off?", "detail": "Near-term cash/runway and company-health read may hand off later — depends on ownership clarity and how other domains settle first.", "status": "open"},
    {"id": "q-os-small-pieces", "kind": "open-question", "name": "What does partnering on the OS look like as small pieces?", "detail": "Weekly sync pattern, En Dash time selection, and naming ownership are the piece-sized partnerships — avoid dumping whole-slice OS ownership on one person.", "status": "open"},
    {"id": "q-delivery-rescue", "kind": "open-question", "name": "Who owns delivery rescue when it is gray?", "detail": "Delivery rescue is still fuzzy — need a named posture without inventing a hierarchy. Line project health oversight (proposed for John) may surface early signals but is BD-adjacent, not the same seat.", "status": "open"},
    {"id": "strength-fit-judgement", "kind": "strength", "name": "Fit judgement", "level": 5},
    {"id": "strength-pricing", "kind": "strength", "name": "Pricing", "level": 3}
  ],
