  "nodes": [
    {"id": "person-nick", "kind": "person", "name": "Nick Daniel", "role": "President / founding partner", "notes": "Lead consultant; currently owns nearly everything including SaaS admin and cloud infra for sites/micro-apps. Hub-and-spoke syncs with almost everyone near-weekly."},
    {"id": "person-steve", "kind": "person", "name": "Steve Daniel", "role": "Co-founder / consultant"},
