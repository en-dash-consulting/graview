{
  "name": "@graview/core",
  "version": "0.1.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "default": "./dist/document/index.js"
    },
    "./describe": {
      "types": "./dist/describe.d.ts",
      "default": "./dist/describe.js"
    },
    "./figures": {
      "types": "./dist/figures.d.ts",
      "default": "./dist/figures.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "default": "./dist/scene.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "default": "./dist/blocks.js"
    },
    "./arrange": {
      "types": "./dist/arrange.d.ts",
      "default": "./dist/arrange.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./sqlite": {
      "types": "./dist/persistence/sqlite.d.ts",
      "default": "./dist/persistence/sqlite.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold/index.d.ts",
      "default": "./dist/scaffold/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "better-sqlite3": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "description": "The graph, the log, the schema and the checker. Everything a Graview app declares, and the CLI that verifies it.",
  "keywords": [
    "graview",
    "context-graph",
    "typed-graph",
    "interface",
    "declarative",
    "schema",
    "invariants",
    "op-log",
    "checker",
    "zod"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/graview.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Elastic-2.0",
  "homepage": "https://graview.dev/docs/packages/core.html",
  "bugs": {
    "url": "https://github.com/en-dash-consulting/graview/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
