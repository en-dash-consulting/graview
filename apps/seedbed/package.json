{
  "name": "@graview/seedbed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A community garden, and the chapters the docs teach from. It opens on the example garden; Start empty gives the blank graph, where onboarding is filling it in.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/app.d.ts",
      "default": "./dist/ui/app.js"
    },
    "./open": {
      "types": "./dist/open.d.ts",
      "default": "./dist/open.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/embed": "workspace:*",
    "@graview/layout": "workspace:*",
    "@graview/pages": "workspace:*",
    "@graview/primitives": "workspace:*",
    "@graview/react": "workspace:*",
    "@graview/render": "workspace:*",
    "@graview/rota": "workspace:*",
    "@graview/ship": "workspace:*",
    "@graview/studio": "workspace:*",
    "@graview/tools": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
