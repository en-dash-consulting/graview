{
  "name": "@graview/rota",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The product-grade example: a volunteer shift roster, branded, permissioned, remembered, embedded and open in its own studio.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/app.d.ts",
      "default": "./dist/ui/app.js"
    },
    "./open": {
      "types": "./dist/open.d.ts",
      "default": "./dist/open.js"
    },
    "./views": {
      "types": "./dist/ui/views.d.ts",
      "default": "./dist/ui/views.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@graview/core": "workspace:*",
    "@graview/embed": "workspace:*",
    "@graview/layout": "workspace:*",
    "@graview/pages": "workspace:*",
    "@graview/primitives": "workspace:*",
    "@graview/react": "workspace:*",
    "@graview/render": "workspace:*",
    "@graview/ship": "workspace:*",
    "@graview/studio": "workspace:*",
    "@graview/tools": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
