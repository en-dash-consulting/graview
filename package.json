{
  "name": "graview-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc -b packages/core packages/layout packages/tools packages/render packages/react packages/primitives",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node packages/core/dist/cli/index.js check",
    "lint": "tsc -b --dry"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@webgpu/types": "^0.1.60",
    "playwright": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}