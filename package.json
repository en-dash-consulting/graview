{
  "name": "graview-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b packages/core packages/layout packages/tools packages/render packages/react packages/primitives packages/pages packages/ship packages/studio packages/embed packages/skills packages/create-graview",
    "typecheck": "tsc -b packages/core packages/layout packages/tools packages/render packages/react packages/primitives packages/pages packages/ship packages/studio packages/embed packages/skills packages/create-graview apps/todo apps/launcher apps/seedbed apps/rota",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node packages/core/dist/cli/index.js check apps/todo/dist/domain/app.js && node packages/core/dist/cli/index.js check apps/launcher/dist/domain/app.js && node packages/core/dist/cli/index.js check apps/seedbed/dist/domain/app.js && node packages/core/dist/cli/index.js check apps/rota/dist/domain/app.js",
    "lint": "tsc -b --dry",
    "spike": "node apps/spike/scripts/run-spike.mjs",
    "shrunk": "node scripts/verify-shrunk.mjs",
    "seat": "node scripts/verify-seat.mjs",
    "survey": "node scripts/survey-ui.mjs",
    "site": "node scripts/verify-site.mjs",
    "apps": "pnpm --filter @graview/launcher dev",
    "changeset": "changeset",
    "pack:inspect": "node scripts/inspect-pack.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "skills": "node packages/skills/dist/cli.js install .",
    "dev:todo": "pnpm --filter @graview/todo dev",
    "engines": "node scripts/verify-engines.mjs",
    "menu": "node scripts/verify-menu.mjs",
    "chat": "node scripts/verify-chat.mjs",
    "navigation": "node scripts/verify-navigation.mjs",
    "pages": "node scripts/verify-pages.mjs",
    "remember": "node scripts/verify-remember.mjs",
    "promo": "pnpm --filter @graview/promo dev",
    "dev:promo": "pnpm --filter @graview/promo dev",
    "dev": "pnpm --filter @graview/todo dev",
    "dev:seedbed": "pnpm --filter @graview/seedbed dev",
    "a11y": "node apps/todo/scripts/run-a11y.mjs",
    "apps:all": "pnpm --parallel --filter @graview/launcher --filter @graview/todo --filter @graview/seedbed --filter @graview/rota dev",
    "audit-ui": "node scripts/audit-ui.mjs",
    "elm": "node scripts/eval-elm.mjs",
    "smoke:create": "node scripts/smoke-create.mjs",
    "graview": "node packages/core/dist/cli/index.js",
    "progression": "node scripts/progression.mjs",
    "site:build": "pnpm --filter @graview/seedbed exec vite build --config vite.site.config.ts",
    "studio": "node scripts/verify-studio.mjs",
    "calendar": "node scripts/verify-calendar.mjs",
    "dev:rota": "pnpm --filter @graview/rota dev",
    "rota": "node scripts/verify-rota.mjs"
  },
  "devDependencies": {
    "@astermind/astermind-elm": "^2.1.1",
    "@changesets/cli": "^3.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.60",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.0.1",
    "playwright": "1.49.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
