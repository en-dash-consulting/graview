      "jobs": [
        {
          "name": "version",
          "steps": [
            {
              "kind": "checkout",
              "uses": "actions/checkout@v4"
            },
            {
              "kind": "other",
              "uses": "pnpm/action-setup@v4"
            },
            {
              "kind": "setup",
              "uses": "actions/setup-node@v4"
            },
            {
              "kind": "install",
              "run": "pnpm install --frozen-lockfile"
            },
            {
              "kind": "other",
              "name": "What there is to do",
              "run": "set -euo pipefail\nif ls .changeset/*.md 2>/dev/null | grep -qv README.md; then PENDING=true; else PENDING=false; fi\nVERSION=$(node -p \"require('./packages/graview/package.json').version\")\nif npm view \"graview@${VERSION}\" version >/dev/null 2>&1; then UNPUBLISHED=false; else UNPUBLISHED=true; fi\necho \"Changesets pending: ${PENDING}; graview@${VERSION} unpublished: ${UNPUBLISHED}\"\necho \"pending=${PENDING}\" >> \"$GITHUB_OUTPUT\"\necho \"unpublished=${UNPUBLISHED}\" >> \"$GITHUB_OUTPUT\""
            },
            {
              "kind": "other",
              "name": "Open or update the Version packages pull request",
              "uses": "changesets/action@v2"
            },
            {
              "kind": "publish",
              "name": "Run CI on it",
              "run": "gh workflow run ci.yml --ref changeset-release/main"
            }
          ]
        },
        {
          "name": "publish",
          "steps": [
            {
              "kind": "checkout",
              "uses": "actions/checkout@v4"
            },
            {
              "kind": "other",
              "uses": "pnpm/action-setup@v4"
            },
            {
              "kind": "setup",
              "uses": "actions/setup-node@v4"
            },
            {
              "kind": "install",
              "name": "npm that can do trusted publishing",
              "run": "npm install -g npm@11.15.0"
            },
            {
              "kind": "install",
              "run": "pnpm install --frozen-lockfile"
            },
            {
              "kind": "build",
              "run": "pnpm build"
            },
            {
              "kind": "typecheck",
              "run": "pnpm typecheck"
            },
            {
              "kind": "test",
              "run": "pnpm test"
            },
            {
              "kind": "other",
              "name": "The last nightly on main holds",
              "run": "set -euo pipefail\nRESULT=$(gh run list --workflow nightly.yml --branch main --status completed --limit 1 --json conclusion,headSha,url --jq '.[0] // empty | \"\\(.conclusion) \\(.headSha[0:8]) \\(.url)\"')\nif [ -z \"$RESULT\" ]; then\n  echo \"::error::no finished Nightly on main — run it (Actions → Nightly → Run workflow), then re-run this job\"\n  exit 1\nfi\necho \"Last nightly: $RESULT\"\ncase \"$RESULT\" in\n  success*) ;;\n  *) echo \"::error::the last Nightly on main is not green: $RESULT\"; exit 1 ;;\nesac"
            },
            {
              "kind": "publish",
              "name": "Publish, tag and release",
              "run": "git config user.name \"github-actions[bot]\"\ngit config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\nnode scripts/release-publish.mjs"
            },
            {
              "kind": "publish",
              "name": "The tags and releases match what npm has",
              "run": "set -euo pipefail\nVERSION=$(node -p \"require('./packages/graview/package.json').version\")\nFAILED=0\nfor dir in packages/*/; do\n  NAME=$(node -p \"require('./${dir}package.json').name\")\n  TAG=\"${NAME}@${VERSION}\"\n  SERVED=0\n  for TRY in $(seq 1 30); do\n    if npm view \"${TAG}\" version --prefer-online >/dev/null 2>&1; then SERVED=1; break; fi\n    sleep 20\n  done\n  if [ \"$SERVED\" = 0 ]; then\n    echo \"::error::${TAG} is not on npm after ten minutes\"; FAILED=1\n  fi\n  if ! git ls-remote --tags origin \"refs/tags/${TAG}\" | grep -q .; then\n    echo \"::error::no tag ${TAG} on origin\"; FAILED=1\n  fi\n  if ! gh release view \"${TAG}\" >/dev/null 2>&1; then\n    echo \"::error::no GitHub release ${TAG}\"; FAILED=1\n  fi\ndone\nexit $FAILED"
            }
          ],
          "needs": [
            "version"
          ],
          "condition": "needs.version.outputs.pending == 'false' && needs.version.outputs.unpublished == 'true'",
          "environment": "npm"
        }
