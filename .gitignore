# Machine-specific or logged, not metadata: the codex MCP config carries
# absolute paths, and the command log is a transcript.
.codex/config.toml
claude_commands.log

# Sourcevision's narration log writes absolute paths on every run; the
# analysis beside it is committed, the log of producing it is not.
.ndx/sourcevision/.cache/narration.log

# The discography example builds its page into build/ (dist/ is the declaration).
apps/discography/build/
apps/gauntlet/build/

# The vgpu skill is local tooling for apps/spike's WebGPU work, not part of
# Graview; a product installs the graview-* skills, never this one.
.claude/skills/vgpu/

# The served rota's fixture is its snapshot and log; the epochs and the
# compaction archive the file adapter writes beside them are derived.
apps/*/data/**/epochs.json
apps/*/data/**/archive/
ndx-export/
.ndx/sourcevision/.cache/analyze-progress.json
